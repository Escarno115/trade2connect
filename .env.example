# Supabase project configuration
# Get these from your Supabase project settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Vite-specific Supabase configuration (used by the frontend build)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PROJECT_ID=your-supabase-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Google Maps connector credentials (optional — only needed for address autocomplete)
# Get these from the Lovable Google Maps connector settings
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=your-google-maps-browser-key
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=your-google-maps-tracking-id
